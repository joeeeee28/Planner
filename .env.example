# ─────────────────────────────────────────────────────────────────────────────
# Growth OS V5 — Client Environment Variables
# Copy this file to `.env` and fill in your project values.
#
# PUBLIC CLIENT VARIABLES (safe to bundle in frontend):
#   - VITE_SUPABASE_URL:             Supabase Project URL (https://<project-ref>.supabase.co)
#   - VITE_SUPABASE_ANON_KEY:        Supabase Anon Key (Public Key — RLS protects data)
#   - VITE_GOOGLE_CALENDAR_BACKEND:  Optional backend service URL for Google OAuth exchange
#   - VITE_OUTLOOK_CALENDAR_BACKEND: Optional backend service URL for Outlook OAuth exchange
#   - VITE_MARKET_DATA_BACKEND:      Optional backend service URL for Market Data (/api/market)
#   - VITE_JOTHIKA_USER_ID:          Optional Supabase User ID for Jothika portfolio migration
#
# PRIVATE BACKEND VARIABLES (NEVER put into frontend .env):
#   - Service-role keys, DB passwords, OAuth client secrets, or private keys
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CALENDAR_BACKEND=
VITE_OUTLOOK_CALENDAR_BACKEND=
VITE_MARKET_DATA_BACKEND=
VITE_JOTHIKA_USER_ID=

